---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const details = await getCollection("projectDetails");
  const projects = (await getCollection("projects", (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
  const withDetail = projects.filter((p) => details.some((d) => d.id === p.id));
  return withDetail.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      detail: details.find((d) => d.id === project.id)!,
      prev: withDetail[i - 1] ?? null,
      next: withDetail[i + 1] ?? null,
      total: projects.length,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  detail: CollectionEntry<"projectDetails">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
  total: number;
}

const { project, detail, prev, next, total } = Astro.props;
const { title, order, period, roles, stack, summary, url, links, archived, gallery = [] } = project.data;
const { Content } = await render(detail);

const [lead, ...rest] = gallery;
const num = String(order).padStart(2, "0");
const pageTitle = `${title} — j. sik`;
const description = summary ?? `${title} — ${roles.join(" · ")} · ${stack.join(", ")}`;
const ogImage = lead?.src ?? "/images/html_meta/thumbnail.png";

const allLinks = [
  { label: /github\.com/.test(url) ? "GitHub" : "바로가기", url, download: false },
  ...links,
];
---

<Base title={pageTitle} description={description} ogImage={ogImage} ogType="article" current="projects">
  <article class="detail">
    <div class="container detail__hero">
      <a class="detail__back mono" href="/#projects">← 프로젝트로 돌아가기</a>

      {
        lead && (
          <figure class="figure">
            <button
              class="figure__zoom"
              type="button"
              data-zoom
              data-src={lead.src}
              data-caption={lead.caption}
              data-w={lead.width}
              data-h={lead.height}
              aria-label={`크게 보기: ${lead.caption}`}
            >
              <img
                class="figure__img"
                src={lead.src}
                alt={lead.caption}
                width={lead.width}
                height={lead.height}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="figure__hint mono" aria-hidden="true">크게 보기 +</span>
            </button>
            <figcaption class="figure__caption">
              <span class="figure__no mono">01</span>
              {lead.caption}
            </figcaption>
          </figure>
        )
      }

      <div class="detail__title-block">
        <div class="detail__title">
          <p class="eyebrow">Project {num} / {total}</p>
          <h1 class="display detail__h1">{title}</h1>
          {summary && <p class="detail__summary">{summary}</p>}
        </div>

        <dl class="meta">
          {
            period && (
              <div class="meta__row">
                <dt class="meta__key mono">기간</dt>
                <dd class="meta__val">{period}</dd>
              </div>
            )
          }
          <div class="meta__row">
            <dt class="meta__key mono">역할</dt>
            <dd class="meta__val meta__chips">{roles.map((r) => <span class="chip">{r}</span>)}</dd>
          </div>
          <div class="meta__row">
            <dt class="meta__key mono">기술</dt>
            <dd class="meta__val meta__chips">{stack.map((s) => <span class="chip">{s}</span>)}</dd>
          </div>
          <div class="meta__row">
            <dt class="meta__key mono">링크</dt>
            <dd class="meta__val meta__links">
              {
                allLinks.map((l) => (
                  <a
                    class="btn-pill"
                    href={l.url}
                    target={l.download ? undefined : "_blank"}
                    rel={l.download ? undefined : "noopener noreferrer"}
                    download={l.download ? true : undefined}
                  >
                    {l.label} {l.download ? "↓" : "↗"}
                  </a>
                ))
              }
            </dd>
          </div>
          {
            archived && (
              <div class="meta__row">
                <dt class="meta__key mono">안내</dt>
                <dd class="meta__val muted">퍼블리싱 연습 작업물입니다. 실제 서비스가 아닙니다.</dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>

    <div class="container detail__body">
      <div class="prose">
        <Content />
      </div>

      {
        rest.length > 0 && (
          <section class="gallery" aria-labelledby="gallery-title">
            <div class="section__title">
              <p class="eyebrow">Figures — {gallery.length}</p>
              <h2 class="display detail__h2" id="gallery-title">작업 화면</h2>
            </div>
            <ul class:list={["gallery__list", { "gallery__list--many": rest.length > 4 }]}>
              {rest.map((g, i) => (
                <li>
                  <figure class="figure">
                    <button
                      class="figure__zoom"
                      type="button"
                      data-zoom
                      data-src={g.src}
                      data-caption={g.caption}
                      data-w={g.width}
                      data-h={g.height}
                      aria-label={`크게 보기: ${g.caption}`}
                    >
                      <img
                        class="figure__img"
                        src={g.src}
                        alt={g.caption}
                        width={g.width}
                        height={g.height}
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="figure__hint mono" aria-hidden="true">크게 보기 +</span>
                    </button>
                    <figcaption class="figure__caption">
                      <span class="figure__no mono">{String(i + 2).padStart(2, "0")}</span>
                      {g.caption}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <nav class="pager" aria-label="다른 프로젝트">
        {
          prev ? (
            <a class="pager__item" href={`/projects/${prev.id}/`} rel="prev">
              <span class="eyebrow eyebrow--muted">← Prev</span>
              <span class="pager__name display">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="pager__item pager__item--next" href={`/projects/${next.id}/`} rel="next">
              <span class="eyebrow eyebrow--muted">Next →</span>
              <span class="pager__name display">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>

  {
    gallery.length > 0 && (
      <dialog class="lightbox" data-lightbox aria-label="이미지 크게 보기">
        <div class="lightbox__bar">
          <span class="lightbox__count mono" data-lb-count />
          <button class="btn-pill" type="button" data-lb-close>
            닫기 <span aria-hidden="true">×</span>
          </button>
        </div>
        <figure class="lightbox__figure">
          <img class="lightbox__img" data-lb-img alt="" decoding="async" />
          <figcaption class="lightbox__caption" data-lb-caption />
        </figure>
        <div class="lightbox__nav">
          <button class="btn-pill" type="button" data-lb-prev>
            <span aria-hidden="true">←</span> 이전
          </button>
          <button class="btn-pill" type="button" data-lb-next>
            다음 <span aria-hidden="true">→</span>
          </button>
        </div>
      </dialog>
    )
  }
</Base>

<style>
  .detail__hero {
    display: grid;
    gap: var(--pf-space-10);
    padding-block: var(--pf-space-4) var(--pf-space-20);
  }

  .detail__back {
    font-size: var(--pf-text-xs);
    letter-spacing: 0.04em;
    color: var(--pf-color-muted);
    justify-self: start;
  }

  .detail__back:hover {
    color: var(--pf-color-text);
  }

  .figure {
    display: grid;
    gap: var(--pf-space-3);
  }

  .figure__img {
    width: 100%;
    aspect-ratio: var(--pf-size-gallery-ratio);
    object-fit: cover;
    border-radius: var(--pf-radius-md);
    background: var(--pf-color-thumb);
  }

  .figure__zoom {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--pf-radius-md);
    cursor: zoom-in;
  }

  .figure__hint {
    position: absolute;
    right: var(--pf-space-3);
    bottom: var(--pf-space-3);
    padding: var(--pf-space-1) var(--pf-space-3);
    border-radius: var(--pf-radius-pill);
    background: var(--pf-color-scrim);
    font-size: var(--pf-text-2xs);
    letter-spacing: 0.04em;
    color: var(--pf-color-text);
    opacity: 0;
    transition: opacity var(--pf-duration) var(--pf-ease);
  }

  .figure__zoom:hover .figure__hint,
  .figure__zoom:focus-visible .figure__hint {
    opacity: 1;
  }

  .figure__caption {
    display: flex;
    gap: var(--pf-space-3);
    align-items: baseline;
    font-size: var(--pf-text-sm);
    color: var(--pf-color-muted);
  }

  .figure__no {
    font-size: var(--pf-text-2xs);
    letter-spacing: 0.04em;
    color: var(--pf-color-accent);
  }

  .detail__title-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: var(--pf-space-16);
    align-items: start;
  }

  .detail__title {
    display: grid;
    gap: var(--pf-space-5);
  }

  .detail__h1 {
    font-size: var(--pf-text-5xl);
  }

  .detail__summary {
    font-size: var(--pf-text-lg);
    line-height: var(--pf-line-relaxed);
    color: var(--pf-color-muted);
    max-width: 50ch;
  }

  .meta {
    display: grid;
    gap: var(--pf-space-6);
    margin: 0;
  }

  .meta__row {
    display: grid;
    gap: var(--pf-space-2);
  }

  .meta__key {
    font-size: var(--pf-text-2xs);
    letter-spacing: var(--pf-tracking-wide);
    color: var(--pf-color-muted);
  }

  .meta__val {
    margin: 0;
    font-size: var(--pf-text-base);
    line-height: var(--pf-line-relaxed);
  }

  .meta__chips,
  .meta__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pf-space-2);
  }

  .detail__body {
    display: grid;
    gap: var(--pf-space-16);
    border-top: var(--pf-hairline) solid var(--pf-color-line);
    padding-block: var(--pf-space-20);
  }

  /* 마크다운 본문: "## 제목"은 왼쪽 열, 그 아래 내용은 오른쪽 열 */
  .prose {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 50rem);
    column-gap: var(--pf-space-16);
    row-gap: var(--pf-space-4);
    font-size: var(--pf-text-md);
    line-height: var(--pf-line-loose);
  }

  .prose :global(h2) {
    grid-column: 1;
    font-family: var(--pf-font-display);
    font-weight: var(--pf-weight-display);
    font-size: var(--pf-text-3xl);
    line-height: var(--pf-line-snug);
    letter-spacing: var(--pf-tracking-snug);
    margin-top: var(--pf-space-12);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    grid-column: 2;
    margin: 0;
  }

  /* 제목 바로 뒤 첫 내용도 제목과 같은 윗여백을 가져야 같은 줄에 맞는다 (margin:0 규칙보다 뒤에, 더 구체적으로) */
  .prose :global(h2 + p),
  .prose :global(h2 + ul),
  .prose :global(h2 + ol) {
    margin-top: var(--pf-space-12);
  }

  .prose :global(h2:first-child + p),
  .prose :global(h2:first-child + ul),
  .prose :global(h2:first-child + ol) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--pf-space-3);
    padding: 0;
  }

  .prose :global(li) {
    position: relative;
    padding-left: var(--pf-space-5);
  }

  .prose :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: var(--pf-size-dot);
    height: var(--pf-size-dot);
    border-radius: var(--pf-radius-pill);
    background: var(--pf-color-accent);
  }

  .prose :global(strong) {
    font-weight: var(--pf-weight-semibold);
    color: var(--pf-color-text);
  }

  .prose :global(a) {
    color: var(--pf-color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .gallery {
    display: grid;
    gap: var(--pf-space-10);
  }

  .detail__h2 {
    font-size: var(--pf-text-3xl);
  }

  .gallery__list {
    display: grid;
    gap: var(--pf-space-12);
  }

  .gallery__list--many {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pf-space-10) var(--pf-space-6);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--pf-space-8);
    border-top: var(--pf-hairline) solid var(--pf-color-line);
    padding-top: var(--pf-space-10);
  }

  .pager__item {
    display: grid;
    gap: var(--pf-space-2);
  }

  .pager__item--next {
    text-align: right;
    justify-items: end;
  }

  .pager__name {
    font-size: var(--pf-text-2xl);
    letter-spacing: var(--pf-tracking-snug);
  }

  /* ---------- 크게 보기 창 ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--pf-space-5) var(--pf-gutter) var(--pf-space-6);
    border: 0;
    background: transparent;
    color: var(--pf-color-text);
    overscroll-behavior: contain;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--pf-space-5);
  }

  .lightbox::backdrop {
    background: var(--pf-color-scrim);
    backdrop-filter: blur(var(--pf-blur-strong));
  }

  .lightbox__bar,
  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--pf-space-4);
  }

  .lightbox__count {
    font-size: var(--pf-text-xs);
    letter-spacing: 0.04em;
    color: var(--pf-color-muted);
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--pf-space-4);
    min-height: 0;
  }

  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    cursor: zoom-out;
  }

  .lightbox__caption {
    text-align: center;
    font-size: var(--pf-text-sm);
    color: var(--pf-color-muted);
  }

  .lightbox__nav {
    justify-content: center;
  }

  @media (max-width: 56rem) {
    .detail__title-block,
    .prose {
      grid-template-columns: minmax(0, 1fr);
    }
    .prose :global(h2),
    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol) {
      grid-column: 1;
    }
    .prose :global(h2 + p),
    .prose :global(h2 + ul),
    .prose :global(h2 + ol) {
      margin-top: 0;
    }
    .prose :global(h2) {
      margin-top: var(--pf-space-10);
    }
    .prose :global(h2:first-child) {
      margin-top: 0;
    }
    .gallery__list--many {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const zooms = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-zoom]"));

  if (dialog && zooms.length > 0) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lb-img]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-lb-caption]")!;
    const count = dialog.querySelector<HTMLElement>("[data-lb-count]")!;
    const prev = dialog.querySelector<HTMLButtonElement>("[data-lb-prev]")!;
    const next = dialog.querySelector<HTMLButtonElement>("[data-lb-next]")!;
    const close = dialog.querySelector<HTMLButtonElement>("[data-lb-close]")!;
    const pad = (n: number) => String(n).padStart(2, "0");
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + zooms.length) % zooms.length;
      const b = zooms[index];
      img.src = b.dataset.src ?? "";
      img.alt = b.dataset.caption ?? "";
      img.width = Number(b.dataset.w);
      img.height = Number(b.dataset.h);
      caption.textContent = b.dataset.caption ?? "";
      count.textContent = `${pad(index + 1)} / ${pad(zooms.length)}`;
      prev.hidden = next.hidden = zooms.length < 2;
    };

    zooms.forEach((b, i) =>
      b.addEventListener("click", () => {
        opener = b;
        show(i);
        dialog.showModal();
        close.focus();
      }),
    );
    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    close.addEventListener("click", () => dialog.close());

    // 사진·버튼이 아닌 곳(바깥 여백)을 누르면 닫는다. Esc는 dialog가 스스로 처리한다
    dialog.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el === img || !el.closest("button, figcaption")) dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    dialog.addEventListener("close", () => {
      img.removeAttribute("src");
      opener?.focus();
    });
  }
</script>
