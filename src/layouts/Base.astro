---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** 사이트 기준 절대 경로 또는 완전한 주소 */
  ogImage?: string;
  ogType?: "website" | "article";
  /** 머리말에서 강조할 구간 (홈에서는 스크롤에 따라 자동 갱신) */
  current?: "home" | "projects" | "work" | "skills" | "";
}

const {
  title,
  description,
  ogImage = "/images/html_meta/thumbnail.png",
  ogType = "website",
  current = "",
} = Astro.props;

const site = Astro.site ?? new URL("https://jsiksn.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageAbs = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="j. sik" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="j. sik" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <meta name="google-site-verification" content="Ld6Eni1KKIcAuYBeRXxr3tyn8axSkFSxi5b56HerduQ" />
    <meta name="naver-site-verification" content="68a9efa5aaa682acec45e726b59f8c9432a3e1b7" />

    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <meta name="theme-color" content="#0e0f12" />

    <!-- 영문 글꼴은 자체 제공(public/fonts) + 미리 불러오기. 본문 한글(Pretendard)은 화면 그리기를 막지 않게 뒤로 미룸 -->
    <link rel="preload" href="/fonts/archivo-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      />
    </noscript>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header current={current} />
    <div class="top-sentinel" data-top-sentinel aria-hidden="true"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <button class="to-top btn-pill btn-pill--surface" type="button" data-to-top aria-label="맨 위로">
      맨 위로 <span aria-hidden="true">↑</span>
    </button>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--pf-space-2);
    left: var(--pf-space-2);
    z-index: 100;
    padding: var(--pf-space-2) var(--pf-space-3);
    background: var(--pf-color-accent);
    color: var(--pf-color-on-accent);
    font-family: var(--pf-font-mono);
    font-size: var(--pf-text-xs);
    border-radius: var(--pf-radius-sm);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }

  #main:focus {
    outline: none;
  }

  /* 첫 화면 높이만큼의 표지. 이게 화면 밖으로 나가면 "맨 위로"를 보인다 */
  .top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100vh;
    pointer-events: none;
  }

  .to-top {
    position: fixed;
    right: var(--pf-gutter);
    bottom: var(--pf-space-6);
    z-index: 40;
    backdrop-filter: blur(var(--pf-blur));
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--pf-space-3));
    transition:
      opacity var(--pf-duration) var(--pf-ease),
      transform var(--pf-duration) var(--pf-ease),
      visibility 0s linear var(--pf-duration),
      border-color var(--pf-duration) var(--pf-ease);
  }

  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
</style>

<script>
  const toTop = document.querySelector<HTMLButtonElement>("[data-to-top]");
  const sentinel = document.querySelector<HTMLElement>("[data-top-sentinel]");
  const main = document.getElementById("main");

  if (toTop && sentinel && main) {
    // 첫 화면 높이를 지나면 보이고, 돌아오면 숨긴다
    const io = new IntersectionObserver(([entry]) => {
      toTop.classList.toggle("is-visible", !entry.isIntersecting);
    });
    io.observe(sentinel);

    toTop.addEventListener("click", () => {
      window.scrollTo({ top: 0 }); // 부드럽게 움직일지는 html의 scroll-behavior가 정한다(움직임 줄이기 설정 존중)
      main.focus({ preventScroll: true });
    });
  }
</script>
