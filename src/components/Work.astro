---
import { Image } from "astro:assets";

// 지금 사이트 Work 구간 문구 그대로 (FR-WK-01 — 이력서·경력기술서 없음)
const items = [
  "html, CSS, javascript, jQuery, Figma 등 국가기간전략훈련 이수",
  "3개 웹사이트 디자인 리뉴얼",
  "신한미래설계 모바일 어플리케이션 디자인 참여",
  "6개 브랜드, 12개 지점 웨딩홀 온/오프라인 브랜드 디자인",
  "사인물, 인쇄물, 온라인 등 외부업체 커뮤니케이션",
  "대기업 및 공사 근무 경험",
  "팀 리더 역할 경험",
  "완성형 한글폰트 제작 교육 이수 및 전시회 참여",
];

// 디자인 작업물 — 옛 사이트 alt/title 그대로 (FR-WK-02)
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/design/*.jpg", { eager: true });
const works = [
  { file: "d01.jpg", title: "한의원 브랜딩" },
  { file: "d02.jpg", title: "신한은행 어플리케이션" },
  { file: "d03.jpg", title: "아스트라제네카 심포지엄" },
  { file: "d04.jpg", title: "알콘 뉴스레터" },
  { file: "d05.jpg", title: "사노피 연하장" },
].map((w) => ({ ...w, src: files[`/src/assets/design/${w.file}`]?.default })).filter((w) => w.src);
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container work__inner">
    <div class="section__title">
      <p class="eyebrow">Work Experience — {items.length}</p>
      <h2 class="display h2" id="work-title">Work Experience</h2>
    </div>

    <div class="work__body">
      <div class="work__left">
        <p class="work__sub">10년 이상의 팀장급 디자인 경력과 논리적 사고를 가진 디자이너 겸 개발자</p>
        <ul class="work__list">
          {
            items.map((it) => (
              <li class="work__item">
                <span class="work__dot" aria-hidden="true" />
                <span>{it}</span>
              </li>
            ))
          }
        </ul>
        <a class="link-mono" href="/documents/Portfolio_Designer_compressed.pdf" download>
          Design Portfolio ↓ <span class="muted">7.6MB</span>
        </a>
      </div>

      <div class="work__right">
        <p class="eyebrow eyebrow--muted">Design Works</p>
        <ul class="design">
          {
            works.map((w) => (
              <li class="design__item">
                <figure>
                  <Image
                    class="design__img"
                    src={w.src!}
                    alt={w.title}
                    title={w.title}
                    widths={[248, 372]}
                    sizes="(max-width: 37.5rem) 42vw, 124px"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="design__caption">{w.title}</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .work__inner {
    display: grid;
    gap: var(--pf-space-12);
  }

  .work__body {
    display: grid;
    grid-template-columns: minmax(0, 35rem) minmax(0, 1fr);
    gap: var(--pf-space-16);
    align-items: start;
  }

  .work__left {
    display: grid;
    gap: var(--pf-space-6);
    justify-items: start;
  }

  .work__sub {
    font-size: var(--pf-text-xl);
    font-weight: var(--pf-weight-medium);
    line-height: var(--pf-line-heading);
    text-wrap: balance;
  }

  .work__list {
    display: grid;
    gap: var(--pf-space-3);
  }

  .work__item {
    display: flex;
    gap: var(--pf-space-3);
    align-items: baseline;
    font-size: var(--pf-text-base);
    line-height: var(--pf-line-relaxed);
    color: var(--pf-color-muted);
  }

  .work__dot {
    flex-shrink: 0;
    width: var(--pf-size-dot);
    height: var(--pf-size-dot);
    border-radius: var(--pf-radius-pill);
    background: var(--pf-color-accent);
    transform: translateY(-0.1em);
  }

  .work__right {
    display: grid;
    gap: var(--pf-space-4);
  }

  .design {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--pf-space-4);
  }

  .design__img {
    aspect-ratio: var(--pf-size-design-ratio);
    width: 100%;
    object-fit: cover;
    border-radius: var(--pf-radius-sm);
    background: var(--pf-color-thumb);
  }

  .design__caption {
    margin-top: var(--pf-space-2);
    font-size: var(--pf-text-xs);
    line-height: var(--pf-line-normal);
    color: var(--pf-color-muted);
  }

  @media (max-width: 56rem) {
    .work__body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pf-space-12);
    }
    .design {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 37.5rem) {
    .design {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
