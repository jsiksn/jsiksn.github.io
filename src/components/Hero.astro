---
import { Image, getImage } from "astro:assets";

// 대표 작업 이미지 — 옛 사이트 첫 화면 슬라이더와 같은 5장(home02는 옛 사이트에서도 꺼져 있었음)
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/hero/*.png", { eager: true });
const slides = [
  { file: "home01.png", alt: "슈피겐 웹사이트 화면" },
  { file: "home03.png", alt: "셀렉토커피 웹사이트 화면" },
  { file: "home04.png", alt: "렉서스 웹사이트 화면" },
  { file: "home05.png", alt: "지산리조트 웹사이트 화면" },
  { file: "home06.png", alt: "더컨벤션 웹사이트 화면" },
].map((s) => ({ ...s, src: files[`/src/assets/hero/${s.file}`]?.default })).filter((s) => s.src);

// sizes 속성은 CSS 변수를 못 쓰므로 px 로 적는다 (여백 20px×2 기준)
const SIZES = "(max-width: 1440px) calc(100vw - 40px), 1312px";
const WIDTHS = [480, 720, 960, 1312, 1920];
const QUALITY = 62;

// 첫 장: 가장 큰 요소(LCP) — 미리 불러오기 위해 주소를 뽑아 둔다
const first = slides[0];
const firstImg = first ? await getImage({ src: first.src!, widths: WIDTHS, format: "webp", quality: QUALITY }) : null;

// 나머지: 화면이 뜬 뒤 스크립트가 불러온다 (첫 화면에서 5장이 한꺼번에 내려오는 것을 막음)
const rest = await Promise.all(
  slides.slice(1).map(async (s) => ({
    ...s,
    img: await getImage({ src: s.src!, widths: WIDTHS, format: "webp", quality: QUALITY }),
  })),
);
---

<section class="hero container" id="home" aria-labelledby="hero-title">
  {
    firstImg && (
      <link
        rel="preload"
        as="image"
        href={firstImg.src}
        imagesrcset={firstImg.srcSet.attribute}
        imagesizes={SIZES}
        fetchpriority="high"
      />
    )
  }

  <div class="hero__media" data-hero-slides aria-roledescription="대표 작업 이미지 넘김">
    {
      first && (
        <Image
          class="hero__slide is-active"
          src={first.src!}
          alt={first.alt}
          widths={WIDTHS}
          sizes={SIZES}
          format="webp"
          quality={QUALITY}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-slide
        />
      )
    }
    {
      rest.map((s) => (
        <img
          class="hero__slide"
          alt={s.alt}
          width={s.img.attributes.width}
          height={s.img.attributes.height}
          sizes={SIZES}
          data-src={s.img.src}
          data-srcset={s.img.srcSet.attribute}
          decoding="async"
          data-slide
          aria-hidden="true"
        />
      ))
    }
  </div>

  <div class="hero__bottom">
    <div class="hero__name">
      <h1 class="hero__title display" id="hero-title">j. sik</h1>
      <p class="hero__role mono">
        Front-end Developer <span class="hero__slash" aria-hidden="true">/</span> Brand · Graphic · Editorial Designer
      </p>
    </div>
    <div class="hero__aside">
      <p class="hero__intro">10년 이상의 팀장급 디자인 경력과 논리적 사고를 가진 디자이너 겸 개발자</p>
      <div class="hero__actions">
        <a class="btn-pill" href="/#work">Work Experience →</a>
        <a class="link-mono" href="/documents/Portfolio_Developer_compressed.pdf" download>
          Development Portfolio ↓ <span class="muted">9.6MB</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--pf-space-12);
    padding-block: var(--pf-space-6) var(--pf-space-24);
  }

  .hero__media {
    position: relative;
    aspect-ratio: 1312 / 520;
    max-height: var(--pf-size-hero-media);
    width: 100%;
    overflow: hidden;
    border-radius: var(--pf-radius-md);
    background: var(--pf-color-thumb);
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0;
    transition: opacity var(--pf-duration-slow) var(--pf-ease);
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--pf-space-16);
    flex-wrap: wrap;
  }

  .hero__name {
    display: grid;
    gap: var(--pf-space-4);
  }

  .hero__title {
    font-size: var(--pf-text-hero);
  }

  .hero__role {
    font-size: var(--pf-text-sm);
    letter-spacing: 0.04em;
    color: var(--pf-color-accent);
  }

  .hero__slash {
    margin-inline: var(--pf-space-2);
    color: var(--pf-color-muted);
  }

  .hero__aside {
    display: grid;
    gap: var(--pf-space-5);
    max-width: 24rem;
  }

  .hero__intro {
    font-size: var(--pf-text-md);
    line-height: var(--pf-line-relaxed);
    color: var(--pf-color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pf-space-3) var(--pf-space-5);
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-block: var(--pf-space-4) var(--pf-space-16);
    }
    .hero__bottom {
      align-items: flex-start;
    }
  }
</style>

<script>
  // 대표 이미지 자동 넘김 — 움직임 줄이기 설정이면 첫 장에서 멈추고 나머지 장은 내려받지 않는다 (FR-HM-02)
  const wrap = document.querySelector<HTMLElement>("[data-hero-slides]");
  const slides = Array.from(wrap?.querySelectorAll<HTMLImageElement>("[data-slide]") ?? []);
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  // 나머지 장의 실제 주소를 채운다 — 첫 화면이 다 뜬 뒤에
  function hydrate() {
    for (const img of slides) {
      if (img.dataset.srcset && !img.srcset) {
        img.srcset = img.dataset.srcset;
        img.src = img.dataset.src ?? "";
      }
    }
  }

  if (slides.length > 1 && !reduce.matches) {
    const start = () => {
      hydrate();
      let i = 0;
      const show = (next: number) => {
        slides[i].classList.remove("is-active");
        slides[i].setAttribute("aria-hidden", "true");
        i = next;
        slides[i].classList.add("is-active");
        slides[i].removeAttribute("aria-hidden");
      };
      let timer = window.setInterval(() => show((i + 1) % slides.length), 4000);
      document.addEventListener("visibilitychange", () => {
        window.clearInterval(timer);
        if (!document.hidden) timer = window.setInterval(() => show((i + 1) % slides.length), 4000);
      });
      reduce.addEventListener("change", () => {
        if (reduce.matches) window.clearInterval(timer);
      });
    };
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
