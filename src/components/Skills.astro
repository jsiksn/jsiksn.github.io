---
// 사용자가 2026-09-11 정리해 준 묶음. "워크플로우 자동화"는 설명이라 제외(n8n과 겹침).
// Tailwind · Chromatic 은 사이트 안 프로젝트에 근거가 없음 — 사용자 판단으로 유지.
const groups = [
  { name: "마크업", items: ["HTML", "CSS", "SCSS", "Tailwind"] },
  { name: "스크립트", items: ["JavaScript", "TypeScript", "jQuery"] },
  { name: "프레임워크", items: ["React", "Bootstrap", "Zustand"] },
  { name: "디자인 시스템", items: ["Storybook", "Chromatic", "Figma REST API"] },
  { name: "AI · 자동화", items: ["Claude Code (AI 페어 프로그래밍)", "MCP", "n8n"] },
  { name: "도구", items: ["Figma", "git", "Lighthouse"] },
  { name: "디자인", items: ["InDesign", "Illustrator", "Photoshop", "Keynote"] },
];
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="container skills__inner">
    <div class="section__title">
      <p class="eyebrow">Skills — {total}</p>
      <h2 class="display h2" id="skills-title">Skills</h2>
    </div>

    <ul class="groups">
      {
        groups.map((g) => (
          <li class="group">
            <p class="group__name mono">{g.name}</p>
            <ul class="group__chips" aria-label={g.name}>
              {g.items.map((s) => (
                <li>
                  <span class="chip chip--skill">{s}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills__inner {
    display: grid;
    gap: var(--pf-space-10);
  }

  .groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pf-space-8) var(--pf-space-10);
  }

  .group {
    display: grid;
    gap: var(--pf-space-3);
  }

  .group__name {
    font-size: var(--pf-text-2xs);
    letter-spacing: var(--pf-tracking-wide);
    color: var(--pf-color-muted);
  }

  .group__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pf-space-2);
  }

  .chip--skill {
    font-family: var(--pf-font-body);
    font-size: var(--pf-text-sm);
    font-weight: var(--pf-weight-medium);
    padding: var(--pf-space-2) var(--pf-space-4);
  }
</style>
